/* =============================================================================
   MODULE: SALES  (new — matches Cajo's sales + deliveries design)
   =============================================================================
   A sale is a customer buying one or more specific SERIALIZED units (already
   assembled via the Manufacturing module). Sale items reference specific
   mfg_assembly_units by id — this is what makes "sold laser #12345 to
   customer X on date Y" a queryable fact, not just aggregated numbers.

   A delivery is a distinct record (1:1 with a sale by default, with room to
   support partial deliveries via delivery_items).
   ========================================================================== */

CREATE TABLE dbo.sales (
    id              NVARCHAR(64)   NOT NULL PRIMARY KEY,
    sale_number     NVARCHAR(50)   NOT NULL,                 -- e.g. 'SALE-0001'
    customer_id     NVARCHAR(64)   NOT NULL REFERENCES dbo.customers(id),
    customer_po_id  NVARCHAR(64)   NULL REFERENCES dbo.customer_purchase_orders(id),
    sale_date       DATE           NOT NULL DEFAULT CAST(SYSUTCDATETIME() AS DATE),
    subtotal        DECIMAL(14,2)  NOT NULL DEFAULT 0,
    tax             DECIMAL(14,2)  NOT NULL DEFAULT 0,
    total           DECIMAL(14,2)  NOT NULL DEFAULT 0,
    is_delivered    BIT            NOT NULL DEFAULT 0,       -- convenience denorm; source of truth is deliveries row
    notes           NVARCHAR(MAX)  NULL,
    created_by      NVARCHAR(64)   NULL REFERENCES dbo.users(id),
    created_at      DATETIME2      NOT NULL DEFAULT SYSUTCDATETIME(),
    updated_by      NVARCHAR(64)   NULL REFERENCES dbo.users(id),
    updated_at      DATETIME2      NOT NULL DEFAULT SYSUTCDATETIME()
);
GO
CREATE UNIQUE INDEX IX_sales_sale_number ON dbo.sales(sale_number);
GO
CREATE INDEX IX_sales_customer ON dbo.sales(customer_id);
GO

CREATE TABLE dbo.sale_items (
    id                  NVARCHAR(64)   NOT NULL PRIMARY KEY,
    sale_id             NVARCHAR(64)   NOT NULL REFERENCES dbo.sales(id) ON DELETE CASCADE,
    -- The specific serialized unit being sold. UNIQUE across all sale_items —
    -- a unit can only be sold once. This is the key traceability link.
    assembly_unit_id    NVARCHAR(64)   NOT NULL REFERENCES dbo.mfg_assembly_units(id),
    item_id             NVARCHAR(64)   NOT NULL REFERENCES dbo.inv_items(id),
    quantity            DECIMAL(14,2)  NOT NULL DEFAULT 1,
    unit_price          DECIMAL(14,2)  NOT NULL,
    line_total          DECIMAL(14,2)  NOT NULL,

    CONSTRAINT UQ_sale_items_unit UNIQUE (assembly_unit_id)  -- a unit can only be sold once
);
GO
CREATE INDEX IX_sale_items_sale ON dbo.sale_items(sale_id);
GO
CREATE INDEX IX_sale_items_item ON dbo.sale_items(item_id);
GO

CREATE TABLE dbo.deliveries (
    id                  NVARCHAR(64)   NOT NULL PRIMARY KEY,
    delivery_number     NVARCHAR(50)   NOT NULL,             -- e.g. 'DEL-0001'
    sale_id             NVARCHAR(64)   NOT NULL REFERENCES dbo.sales(id) ON DELETE CASCADE,
    delivery_address    NVARCHAR(500)  NULL,
    delivery_location   NVARCHAR(200)  NULL,                 -- city/region tag for reporting
    scheduled_date      DATE           NULL,
    delivered_date      DATETIME2      NULL,
    delivered           BIT            NOT NULL DEFAULT 0,
    notes               NVARCHAR(MAX)  NULL,
    created_by          NVARCHAR(64)   NULL REFERENCES dbo.users(id),
    created_at          DATETIME2      NOT NULL DEFAULT SYSUTCDATETIME(),
    updated_by          NVARCHAR(64)   NULL REFERENCES dbo.users(id),
    updated_at          DATETIME2      NOT NULL DEFAULT SYSUTCDATETIME(),

    CONSTRAINT UQ_deliveries_sale UNIQUE (sale_id)           -- 1:1 with sale for now (partial deliveries can be added later)
);
GO
CREATE UNIQUE INDEX IX_deliveries_delivery_number ON dbo.deliveries(delivery_number);
GO

/* Room for partial deliveries later — one row per sale_item actually
   included in this delivery. Empty until we support splitting one sale
   across multiple deliveries; for now every sale_item on the sale is
   implicitly on its one delivery. */
CREATE TABLE dbo.delivery_items (
    id              NVARCHAR(64)   NOT NULL PRIMARY KEY,
    delivery_id     NVARCHAR(64)   NOT NULL REFERENCES dbo.deliveries(id) ON DELETE CASCADE,
    sale_item_id    NVARCHAR(64)   NOT NULL REFERENCES dbo.sale_items(id)
);
GO
CREATE INDEX IX_delivery_items_delivery ON dbo.delivery_items(delivery_id);
GO